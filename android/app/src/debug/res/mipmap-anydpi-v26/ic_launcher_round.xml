<?xml version="1.0" encoding="utf-8"?>
<!-- Relay dev build: orange background + DEV badge so it is never confused with production. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/relaydev_launcher_background" />
    <foreground>
        <layer-list>
            <item android:drawable="@mipmap/ic_launcher_foreground" />
            <item android:drawable="@drawable/relaydev_badge" />
        </layer-list>
    </foreground>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
